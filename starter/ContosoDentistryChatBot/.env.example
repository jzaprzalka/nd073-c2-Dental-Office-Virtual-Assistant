# Azure Bot credentials
MicrosoftAppId=<App ID>
MicrosoftAppType=UserAssignedMSI
MicrosoftAppTenantId=<Tenant ID>
# For local development only, you can use the MicrosoftAppPassword.
# MicrosoftAppPassword=<Password>

# Custom Question Answering (replacement for QnA Maker)
ProjectName=<Custom Question Answering project name>
LanguageEndpointKey=<Language resource key>
LanguageEndpointHostName=https://<language-resource>.cognitiveservices.azure.com/

# Custom Language Understanding (CLU) Intent Recognizer (old LUIS) credentials
CluProjectName=<LUIS project name>
CluDeploymentName=<LUIS deployment name>
CluAPIKey=<Language resource key>
CluAPIHostName=https://<language-resource>.cognitiveservices.azure.com/

# Dentist Scheduler Web App
SchedulerEndpoint=https://<scheduler-web-app-domain>.azurewebsites.net
# For local development use localhost:3000
